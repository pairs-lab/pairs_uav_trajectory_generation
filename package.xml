<?xml version="1.0"?>
<package format="2">

  <name>pairs_uav_trajectory_generation</name>
  <version>1.0.4</version>
  <description>UAV trajectory generation</description>

  <maintainer email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</maintainer>
  <author email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</author>

  <license>Apache 2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cmake_modules</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>nodelet</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>std_msgs</depend>
  <depend>pairs_msgs</depend>
  <depend>pairs_lib</depend>
  <test_depend>pairs_uav_testing</test_depend>
  <depend version_gte="2.4.2">nlopt</depend>

  <export>
    <nodelet plugin="${prefix}/nodelets.xml" />
  </export>

</package>
